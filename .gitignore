# Local Only
Todo.md

# The original client jar bundles the whole Minecraft client. Per the project ground
# rules no Minecraft code lives in this repository, so keep it local for reference only.
old_esdeath_client/

# Gradle
.gradle/
build/
out/
classes/

# Release staging. The build workflow stages the mod jar here, and the installer job
# cross-compiles into installer/dist, so both appear after a local run of those steps.
dist/
installer/dist/

# Launcher (Wails). node_modules and the built frontend are generated. The frontend must be
# built before the Go //go:embed can compile, which `wails build` and the launcher CI job do
# for you; a bare `go build` needs `npm run build` in frontend/ first.
launcher/frontend/node_modules/
launcher/frontend/dist/
launcher/build/bin/

# The Windows resource object (icon, manifest, version block). The launcher CI job generates it
# with go-winres right before the cross-compile, and `go build` links any .syso it finds in the
# package directory, so a local Windows build leaves one here too. Generated, not source.
launcher/*.syso

# The rest of what `wails build` leaves behind in frontend/. wailsjs/ is the JS binding layer
# it regenerates from the Go methods on every build, and the .md5 is the stamp it uses to skip
# `npm install` when package.json has not changed. Both are rebuilt from source, so neither
# belongs in the tree; without these two lines any local launcher build leaves the working
# copy dirty.
launcher/frontend/wailsjs/
launcher/frontend/package.json.md5

# The backend's public site (backend/web). node_modules and the built bundle are generated: the
# Dockerfile builds dist/ in its own stage, and a local `npm run build` in backend/web is only
# needed to preview the page against a locally running API.
backend/web/node_modules/
backend/web/dist/

# The local virtualenv the backend test suite runs in. CI installs its own inside a container.
backend/.venv/

# Loom / Fabric
run/
*.log

